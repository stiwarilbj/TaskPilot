import base64
import copy
import hashlib
import math
import os
import re
from urllib.parse import urlsplit


class ActionContractError(RuntimeError):
    pass


class NativeProtocolError(RuntimeError):
    """A native payload cannot acquire meaning through permissive defaults."""
    code = 'protocol_error'


def _fail(path, error):
    raise ActionContractError(f"{path} {error}")


def _condition(test, value):
    def get(path):
        current = value
        for part in path.split('.'):
            if not isinstance(current, dict) or part not in current: return None
            current = current[part]
        return current
    if 'equals' in test:
        key, expected = test['equals']
        actual = get(key)
        return type(actual) is type(expected) and actual == expected
    if 'same_value' in test:
        a, b = (get(key) for key in test['same_value'])
        return type(a) is type(b) and a == b
    if 'all_verified' in test:
        items = get(test['all_verified'])
        return isinstance(items, list) and bool(items) and all(isinstance(item, dict) and item.get('verified') is True for item in items)
    if 'has' in test: return test['has'] in value
    if 'truthy' in test: return bool(value.get(test['truthy']))
    if 'not' in test: return not _condition(test['not'], value)
    if 'all' in test: return all(_condition(t, value) for t in test['all'])
    if 'any' in test: return any(_condition(t, value) for t in test['any'])
    if 'same_presence' in test:
        a, b = test['same_presence']
        return (a in value) == (b in value)
    raise RuntimeError('Unsupported generated contract condition')


def _rules(rules, value, path):
    for rule in rules:
        if 'when' in rule and not _condition(rule['when'], value): continue
        if 'payload' in rule:
            field = rule['payload']
            text = value[field]
            if value.get(rule['encoding'], rule['default_encoding']) == 'base64':
                try:
                    if len(text) % 4 or len(text) - len(text.rstrip('=')) > 2:
                        raise ValueError('Invalid padding')
                    data = base64.b64decode(text, validate=True)
                except (ValueError, UnicodeEncodeError):
                    _fail(path + '.' + field, 'must be valid base64 for this encoding')
            else: data = text.encode('utf-8')
            if len(data) > rule['max_bytes']: _fail(path + '.' + field, rule['size_error'])
        elif not _condition(rule['assert'], value):
            _fail(path + ('.' + rule['path'] if rule.get('path') else ''), rule['error'])


def _field(value, spec, path):
    if value is None and spec.get('nullable'): return
    kind = spec['type']
    if kind == 'string':
        if not isinstance(value, str): _fail(path, 'must be a string')
        if spec.get('nonempty') and not value.strip(): _fail(path, 'must be a nonempty string')
        try: encoded = value.encode('utf-8')
        except UnicodeEncodeError: _fail(path, 'must contain valid UTF-8 text')
        if spec.get('format') in {'sha256', 'requirement_id', 'uuid'}:
            pattern = {'sha256': r'[0-9a-f]{64}', 'requirement_id': r'r[1-9][0-9]*',
                       'uuid': r'[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}'}[spec['format']]
            if not re.fullmatch(pattern, value): _fail(path, 'must be a valid ' + spec['format'])
        if spec.get('format') == 'path' and (not value.startswith(('/', '~/')) or '\0' in value):
            _fail(path, 'must be an absolute or ~/ path without NUL bytes')
        if spec.get('format') == 'http_url':
            try:
                parsed = urlsplit(value)
                valid = parsed.scheme in {'http', 'https'} and bool(parsed.hostname) and not any(c.isspace() for c in value)
            except ValueError: valid = False
            if not valid: _fail(path, 'must be an http/https URL')
        if (spec.get('no_nul') and '\0' in value) or len(encoded) > spec.get('max_bytes', math.inf):
            _fail(path, spec.get('bytes_error', 'must contain no NUL bytes'))
        candidate = value.lower() if spec.get('casefold') else value
        if 'choices' in spec and candidate not in spec['choices']:
            _fail(path, spec.get('choices_error', 'must be a supported value'))
    elif kind in {'number', 'integer'}:
        if isinstance(value, bool) or not isinstance(value, (int, float)) or (kind == 'integer' and not isinstance(value, int)):
            _fail(path, 'must be an integer' if kind == 'integer' else 'must be a number')
        if not spec['min'] <= value <= spec['max'] or (isinstance(value, float) and not math.isfinite(value)):
            _fail(path, f"must be finite and between {spec['min']:g} and {spec['max']:g}")
    elif kind == 'boolean':
        if type(value) is not bool: _fail(path, 'must be a boolean')
    elif kind == 'array':
        if not isinstance(value, list) or not spec.get('min_items', 0) <= len(value) <= spec.get('max_items', math.inf):
            _fail(path, spec.get('error', 'must be a list'))
        for i, item in enumerate(value):
            item_spec = dict(spec['items'])
            if i == 0 and spec.get('first_nonempty'): item_spec['nonempty'] = True
            try: _field(item, item_spec, f'{path}[{i}]')
            except ActionContractError:
                if spec.get('error') and 'min_items' not in spec: _fail(path, spec['error'])
                raise
        if 'max_bytes' in spec and sum(len(v.encode('utf-8')) + spec.get('separator_bytes', 0) for v in value) > spec['max_bytes']:
            _fail(path, spec['bytes_error'])
    elif kind == 'variant':
        if not isinstance(value, dict): _fail(path, 'must be an object')
        tag = spec['tag']
        selected = value.get(tag)
        if not isinstance(selected, str) or selected not in spec['variants']:
            _fail(path + '.' + tag, spec.get('choices_error', 'must be a supported outcome check'))
        definition = spec['variants'][selected]
        if definition.get('reject_unknown') and set(value) - {tag, *definition['fields']}:
            _fail(path, 'contains unsupported parameters')
        _object(value, definition['fields'], definition['required'], path)
        _rules(definition['rules'], value, path)
    elif kind == 'object':
        if not isinstance(value, dict): _fail(path, 'must be an object')
        if spec.get('reject_unknown') and set(value) - set(spec['fields']): _fail(path, 'contains unsupported parameters')
        _object(value, spec['fields'], spec['required'], path)
        _rules(spec['rules'], value, path)
    elif kind == 'reference':
        _field(value, CONTRACT['native_schemas'][spec['schema']], path)
    else: raise RuntimeError('Unsupported generated contract field')


def _object(value, fields, required, path):
    for field, spec in fields.items():
        if field in value: _field(value[field], spec, path + '.' + field)
    for field in required:
        if field not in value: _fail(path + '.' + field, 'is required')


def validate_action(value):
    if not isinstance(value, dict): _fail('action', 'must be an object')
    action = dict(value)
    kind = action.get('type')
    if not isinstance(kind, str) or kind not in CONTRACT['actions']:
        _fail('action.type', 'must be a supported action')
    for rule in CONTRACT['normalizations']:
        if kind == rule['type'] and action.get(rule['when_truthy']):
            kind = action['type'] = rule['replace_type']
            for key in rule['remove']: action.pop(key, None)
    if 'operation' in action:
        if kind != 'run_command': _fail('action.operation', 'is only supported for run_command')
        action = compile_command_operation(action)
    definition = CONTRACT['actions'][kind]
    _object(action, CONTRACT['fields'], definition['required'], 'action')
    _rules(CONTRACT['common_rules'], action, 'action')
    _rules(definition['rules'], action, 'action')
    return action


def compile_command_operation(action):
    action = copy.deepcopy(action)
    operation = action['operation']
    _field(operation, CONTRACT['fields']['operation'], 'action.operation')
    recipe = CONTRACT['command_operations'][operation['type']]
    if 'command' in action: _fail('action.command', 'cannot accompany a command operation')
    parameters = dict(operation)
    for name, spec in recipe['fields'].items():
        if spec.get('format') == 'path':
            path = os.path.expanduser(parameters[name])
            if '..' in path.split('/'): _fail('action.operation.' + name, 'must not contain parent traversal; use general shell for complex paths')
            parameters[name] = path
    def resolve(value):
        if isinstance(value, dict):
            if set(value) == {'parameter'}: return parameters[value['parameter']]
            return {key: resolve(item) for key, item in value.items()}
        if isinstance(value, list): return [resolve(item) for item in value]
        return value
    argv, checks = resolve(recipe['argv']), resolve(recipe['checks'])
    if 'argv' in action:
        _field(action['argv'], CONTRACT['fields']['argv'], 'action.argv')
        if action['argv'] != argv: _fail('action.argv', 'must match the established operation template')
    if 'checks' in action:
        _field(action['checks'], CONTRACT['fields']['checks'], 'action.checks')
        for check in action['checks']:
            if check not in checks: checks.append(check)
    action['argv'], action['checks'] = argv, checks
    return action


def operation_example(kind):
    return {'type': 'run_command', 'operation': copy.deepcopy(CONTRACT['command_operations'][kind]['example'])}


def action_example(kind):
    return copy.deepcopy(CONTRACT['actions'][kind]['example'])


def validate_outcome_check(value, path='check'):
    _field(value, CONTRACT['fields']['checks']['items'], path)
    return copy.deepcopy(value)


def validate_contract_field(name, value, path):
    _field(value, CONTRACT['fields'][name], path)
    return value


def action_default(kind, field):
    return CONTRACT['actions'][kind]['defaults'][field]


VALID_ACTIONS = frozenset(CONTRACT['actions'])
TRUSTED_NATIVE_ACTIONS = frozenset(k for k, v in CONTRACT['actions'].items() if v['owner'] == 'task_tool')
KEYS = frozenset(CONTRACT['key_codes'])
ACTION_CAPABILITIES = {k: v['capability'] for k, v in CONTRACT['actions'].items() if v.get('capability')}
ACTION_REFERENCE = 'All actions remain available (examples are advisory): ' + '; '.join(v['reference'] for v in CONTRACT['actions'].values()) + '. Keys: ' + ', '.join(CONTRACT['key_codes']) + '; modifiers: ' + ', '.join(CONTRACT['modifier_flags']) + '.\n'
PROMPT_BOUNDS = CONTRACT['prompt_bounds']
COMMAND_OPERATION_REFERENCE = '; '.join(recipe['reference'] for recipe in CONTRACT['command_operations'].values())

TASK_PROTOCOL_VERSION = CONTRACT["task_protocol_version"]


def validate_native_payload(schema, value, path=None):
    path = path or schema
    try:
        _field(value, CONTRACT['native_schemas'][schema], path)
    except ActionContractError as error:
        raise NativeProtocolError(str(error)) from error
    _validate_file_format_payload(schema, value, path)
    return value


def expected_file_format(path):
    if not isinstance(path, str): return None
    suffix = os.path.splitext(path)[1].lower()
    return {'.pdf': 'pdf', '.docx': 'docx', '.xlsx': 'xlsx'}.get(suffix)


def _validate_file_format_payload(schema, value, path):
    if schema == 'check_batch':
        for index, checked in enumerate(value.get('checks', [])):
            _validate_file_format_attestation('check_result', checked, f'{path}.checks[{index}]')
    elif schema == 'action_result':
        if value.get('action_type') == 'write_file' and value.get('verified') is True:
            _validate_file_format_attestation(schema, value, path, required=True)
        for index, checked in enumerate(value.get('checks', [])):
            _validate_file_format_attestation('check_result', checked, f'{path}.checks[{index}]')
    elif schema == 'check_result':
        if value.get('type') in {'file_exists', 'file_contents'}:
            _validate_file_format_attestation(schema, value, path)
    elif schema == 'evidence_fact':
        _validate_file_format_attestation(schema, value, path,
            required=value.get('type') in {'file_exists', 'file_contents', 'file_append', 'file_written'})
    elif schema == 'evidence':
        _validate_file_format_payload('evidence_fact', value['fact'], path + '.fact')
    elif schema == 'receipt' and isinstance(value.get('result'), dict):
        _validate_file_format_payload('action_result', value['result'], path + '.result')


def _validate_file_format_attestation(schema, value, path, required=False):
    file_path = value.get('path')
    expected = expected_file_format(file_path)
    attestation = value.get('file_format')
    if expected is None:
        if attestation is not None:
            raise NativeProtocolError(path + '.file_format is not valid for this destination')
        return
    if attestation is None:
        if required or (schema == 'check_result' and value.get('type') in {'file_exists', 'file_contents'} and value.get('verified') is True):
            raise NativeProtocolError(path + '.file_format is required for a verified ' + expected.upper() + ' result')
        return
    if attestation.get('format') != expected or attestation.get('verified') is not True:
        raise NativeProtocolError(path + '.file_format must verify the requested ' + expected.upper() + ' format')


def validate_check_batch(value, path='result', requested_checks=None):
    validate_native_payload('check_batch', value, path)
    _validate_check_pairs(value['requested_checks'], value['checks'], path)
    if requested_checks is not None:
        def identity(check):
            validate_outcome_check(check)
            target = os.path.normpath(os.path.expanduser(check['path'])) if 'path' in check else None
            data = None
            if check['type'] == 'file_contents':
                data = base64.b64decode(check['content'], validate=True) if check.get('encoding', '').lower() == 'base64' else check['content'].encode()
            elif check['type'] == 'stdout_equals': data = check['text'].encode()
            return check['type'], target, data
        try: matches = [identity(c) for c in value['requested_checks']] == [identity(c) for c in requested_checks]
        except ActionContractError as error: raise NativeProtocolError(str(error)) from error
        if not matches: raise NativeProtocolError(path + '.requested_checks must match the pending readback')
    return value


def validate_native_readback(value, action, path='result'):
    try: action = validate_action(action)
    except ActionContractError as error: raise NativeProtocolError(str(error)) from error
    if action['type'] == 'read_file': return validate_native_result(value, action, path)
    if action['type'] == 'write_file' and action.get('mode', 'overwrite').lower() == 'overwrite':
        requested = [{'type': 'file_contents', **{key: action[key] for key in ('path', 'content', 'encoding') if key in action}}]
    elif action['type'] == 'run_command':
        requested = [c for c in action.get('checks', []) if c['type'] != 'stdout_equals']
    else: raise NativeProtocolError(path + ' cannot acknowledge an unsupported readback')
    return validate_check_batch(value, path, requested)


def _validate_check_pairs(requested, actual, path):
    if len(requested) != len(actual): raise NativeProtocolError(path + '.checks must match requested_checks')
    for index, (check, checked) in enumerate(zip(requested, actual)):
        if (check['type'] != checked['type'] or
                ('path' in check and os.path.normpath(os.path.expanduser(check['path'])) != checked.get('path'))):
            raise NativeProtocolError(f'{path}.checks[{index}] must match the requested target and check')
        if checked['verified'] and check['type'] in {'file_contents', 'stdout_equals'}:
            content = check['text'] if check['type'] == 'stdout_equals' else check['content']
            data = base64.b64decode(content, validate=True) if check.get('encoding', '').lower() == 'base64' else content.encode()
            key = 'text_sha256' if check['type'] == 'stdout_equals' else 'content_sha256'
            if checked[key] != hashlib.sha256(data).hexdigest():
                raise NativeProtocolError(f'{path}.checks[{index}].{key} must match the requested contents')


def validate_native_result(value, action=None, path='result'):
    validate_native_payload('action_result', value, path)
    if action is not None:
        try: action = validate_action(action)
        except ActionContractError as error: raise NativeProtocolError(str(error)) from error
        if value['action_type'] != action.get('type'):
            raise NativeProtocolError(path + '.action_type must match the requested action')
        if action['type'] in {'read_file', 'write_file'} and value['path'] != os.path.normpath(os.path.expanduser(action['path'])):
            raise NativeProtocolError(path + '.path must match the requested target')
        if action['type'] == 'read_file' and value['bytes_returned'] > action.get('max_bytes', action_default('read_file', 'max_bytes')):
            raise NativeProtocolError(path + '.bytes_returned must not exceed the requested read limit')
        if action['type'] == 'write_file':
            data = base64.b64decode(action['content'], validate=True) if action.get('encoding', '').lower() == 'base64' else action['content'].encode()
            if (value['mode'] != action.get('mode', action_default('write_file', 'mode')).lower() or
                    value['bytes_written'] != len(data) or value['content_sha256'] != hashlib.sha256(data).hexdigest()):
                raise NativeProtocolError(path + ' must verify the requested write')
        if action['type'] == 'run_command':
            requested = value.get('outcome_checks', action.get('checks', []))
            if value.get('command_operation') != action.get('operation'):
                raise NativeProtocolError(path + '.command_operation must match the requested operation')
            if 'operation' in action:
                expected = action['checks']
                snapshot = CONTRACT['command_operations'][action['operation']['type']].get('snapshot')
                if requested[:len(expected)] != expected or (not snapshot and requested != expected):
                    raise NativeProtocolError(path + '.outcome_checks must include exactly the requested operation checks')
                if snapshot:
                    extra = requested[len(expected):]
                    candidates = extra or expected
                    if len(extra) > 1 or not any(c.get('type') == 'file_contents' and c.get('encoding') == 'base64' and
                            c.get('path') == action['operation'][snapshot['destination']] for c in candidates):
                        raise NativeProtocolError(path + '.outcome_checks must include the bound source snapshot')
            _validate_check_pairs(requested, value['checks'], path)
    if value['action_type'] == 'run_command':
        for index, checked in enumerate(value['checks']):
            if checked['type'] == 'stdout_equals' and checked['verified'] and (value['stdout_truncated'] or
                    checked['text_sha256'] != hashlib.sha256(value['stdout'].encode()).hexdigest()):
                raise NativeProtocolError(f'{path}.checks[{index}] must verify the returned stdout without truncation')
    if value['action_type'] == 'read_file':
        try: data = base64.b64decode(value['content'], validate=True) if value['encoding'] == 'base64' else value['content'].encode()
        except (ValueError, UnicodeEncodeError) as error: raise NativeProtocolError(path + '.content must match encoding') from error
        if len(data) != value['bytes_returned'] or hashlib.sha256(data).hexdigest() != value['content_sha256']:
            raise NativeProtocolError(path + '.content must match returned length and digest')
    return value


def validate_native_receipt(value, action_id=None, action=None, path='receipt'):
    validate_native_payload('receipt', value, path)
    if action_id is not None and value['action_id'].lower() != action_id.lower():
        raise NativeProtocolError(path + '.action_id must match the pending action')
    result = value.get('result')
    state = value['state']
    if result is not None:
        validate_native_result(result, action, path + '.result')
        if CONTRACT['receipt_outcomes'].get(state) != result['outcome']:
            raise NativeProtocolError(path + '.state must agree with result.outcome')
        if any(key in value for key in CONTRACT['native_schemas']['error']['fields'] if key != 'terminal'):
            raise NativeProtocolError(path + ' cannot contain both result and error fields')
    elif 'error' in value:
        failure = {key: value[key] for key in CONTRACT['native_schemas']['error']['fields'] if key in value}
        validate_native_payload('error', failure, path + '.error_payload')
        if CONTRACT['receipt_outcomes'].get(state) != value['outcome']:
            raise NativeProtocolError(path + '.state must agree with error.outcome')
    return value


def validate_native_evidence(value, path='evidence'):
    validate_native_payload('evidence', value, path)
    if value['verification_scope'] != value['fact']['type']:
        raise NativeProtocolError(path + '.verification_scope must name the verified fact')
    if value['action'] is not None:
        try: validate_action(value['action'])
        except ActionContractError as error: raise NativeProtocolError(str(error)) from error
    return value
