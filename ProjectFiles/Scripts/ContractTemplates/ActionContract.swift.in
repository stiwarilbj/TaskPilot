    static var taskProtocolVersion: Int { (definition["task_protocol_version"] as! NSNumber).intValue }
    struct ValidationError: LocalizedError {
        let path: String
        let expectation: String
        var errorDescription: String? { "\(path) \(expectation)" }
    }
    struct NativeProtocolError: LocalizedError {
        let message: String
        var errorDescription: String? { "Native protocol error: \(message)" }
    }

    static var keyCodes: [String: UInt16] {
        (definition["key_codes"] as! [String: NSNumber]).mapValues { $0.uint16Value }
    }
    static var modifierFlags: [String: UInt64] {
        (definition["modifier_flags"] as! [String: NSNumber]).mapValues { $0.uint64Value }
    }
    static var modifierAliases: [String: String] { definition["modifier_aliases"] as! [String: String] }
    static func limit(_ name: String) -> Int { (definition["limits"] as! [String: NSNumber])[name]!.intValue }
    static func defaultValue(_ kind: ActionKind, _ field: String) -> Any {
        ((definition["actions"] as! [String: [String: Any]])[kind.rawValue]!["defaults"] as! [String: Any])[field]!
    }

    private static func fail(_ path: String, _ expectation: String) throws -> Never {
        throw ValidationError(path: path, expectation: expectation)
    }
    private static func truthy(_ value: Any?) -> Bool {
        guard let value, !(value is NSNull) else { return false }
        if let text = value as? String { return !text.isEmpty }
        if let number = value as? NSNumber { return number.doubleValue != 0 }
        if let items = value as? [Any] { return !items.isEmpty }
        if let items = value as? [String: Any] { return !items.isEmpty }
        return true
    }
    private static func condition(_ test: [String: Any], _ value: [String: Any]) -> Bool {
        func get(_ path: String) -> Any? {
            var current: Any = value
            for part in path.split(separator: ".") {
                guard let object = current as? [String: Any], let next = object[String(part)] else { return nil }
                current = next
            }
            return current
        }
        func equal(_ first: Any?, _ second: Any?) -> Bool {
            guard let first, let second else { return false }
            if let a = first as? NSNumber, let b = second as? NSNumber {
                guard (CFGetTypeID(a) == CFBooleanGetTypeID()) == (CFGetTypeID(b) == CFBooleanGetTypeID()) else { return false }
                return a == b
            }
            return (first as? String) != nil && (first as? String) == (second as? String)
        }
        if let pair = test["equals"] as? [Any] { return equal(get(pair[0] as! String), pair[1]) }
        if let pair = test["same_value"] as? [String] { return equal(get(pair[0]), get(pair[1])) }
        if let key = test["all_verified"] as? String {
            guard let items = get(key) as? [[String: Any]], !items.isEmpty else { return false }
            return items.allSatisfy { equal($0["verified"], true) }
        }
        if let key = test["has"] as? String { return value[key] != nil }
        if let key = test["truthy"] as? String { return truthy(value[key]) }
        if let inner = test["not"] as? [String: Any] { return !condition(inner, value) }
        if let items = test["all"] as? [[String: Any]] { return items.allSatisfy { condition($0, value) } }
        if let items = test["any"] as? [[String: Any]] { return items.contains { condition($0, value) } }
        if let pair = test["same_presence"] as? [String] { return (value[pair[0]] != nil) == (value[pair[1]] != nil) }
        preconditionFailure("Unsupported generated contract condition")
    }
    private static func rules(_ rules: [[String: Any]], _ value: [String: Any], _ path: String) throws {
        for rule in rules {
            if let when = rule["when"] as? [String: Any], !condition(when, value) { continue }
            if let field = rule["payload"] as? String {
                let text = value[field] as! String
                let encoding = value[rule["encoding"] as! String] as? String ?? rule["default_encoding"] as! String
                let bytes: Data
                if encoding == "base64" {
                    let raw = Array(text.utf8)
                    let padding = raw.reversed().prefix(while: { $0 == 61 }).count
                    let letters = raw.prefix(raw.count - padding)
                    guard raw.count % 4 == 0, padding <= 2,
                          letters.allSatisfy({ (65...90).contains($0) || (97...122).contains($0) || (48...57).contains($0) || $0 == 43 || $0 == 47 }),
                          let decoded = Data(base64Encoded: text) else {
                        try fail(path + "." + field, "must be valid base64 for this encoding")
                    }
                    bytes = decoded
                } else { bytes = Data(text.utf8) }
                if bytes.count > (rule["max_bytes"] as! NSNumber).intValue {
                    try fail(path + "." + field, rule["size_error"] as! String)
                }
            } else if !condition(rule["assert"] as! [String: Any], value) {
                let suffix = rule["path"] as? String ?? ""
                try fail(path + (suffix.isEmpty ? "" : "." + suffix), rule["error"] as! String)
            }
        }
    }
    private static func field(_ value: Any, _ spec: [String: Any], _ path: String) throws {
        if value is NSNull, spec["nullable"] as? Bool == true { return }
        switch spec["type"] as! String {
        case "string":
            guard let text = value as? String else { try fail(path, "must be a string") }
            if let format = spec["format"] as? String,
               let pattern = ["sha256": "^[0-9a-f]{64}$", "requirement_id": "^r[1-9][0-9]*$",
                              "uuid": "^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"][format],
               text.range(of: pattern, options: .regularExpression) == nil { try fail(path, "must be a valid " + format) }
            if spec["nonempty"] as? Bool == true, text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
                try fail(path, "must be a nonempty string")
            }
            if spec["format"] as? String == "path", (!(text.hasPrefix("/") || text.hasPrefix("~/")) || text.contains("\0")) {
                try fail(path, "must be an absolute or ~/ path without NUL bytes")
            }
            if spec["format"] as? String == "http_url" {
                guard let url = URLComponents(string: text), ["http", "https"].contains(url.scheme?.lowercased() ?? ""),
                      !(url.host ?? "").isEmpty, text.rangeOfCharacter(from: .whitespacesAndNewlines) == nil else {
                    try fail(path, "must be an http/https URL")
                }
            }
            if (spec["no_nul"] as? Bool == true && text.contains("\0")) || text.utf8.count > ((spec["max_bytes"] as? NSNumber)?.intValue ?? Int.max) {
                try fail(path, spec["bytes_error"] as? String ?? "must contain no NUL bytes")
            }
            let candidate = spec["casefold"] as? Bool == true ? text.lowercased() : text
            if let choices = spec["choices"] as? [String], !choices.contains(candidate) {
                try fail(path, spec["choices_error"] as? String ?? "must be a supported value")
            }
        case "number", "integer":
            let integer = spec["type"] as! String == "integer"
            guard let number = value as? NSNumber, CFGetTypeID(number) != CFBooleanGetTypeID(),
                  !integer || !["f", "d"].contains(String(cString: number.objCType)) else {
                try fail(path, integer ? "must be an integer" : "must be a number")
            }
            let low = (spec["min"] as! NSNumber).doubleValue, high = (spec["max"] as! NSNumber).doubleValue
            if !number.doubleValue.isFinite || number.doubleValue < low || number.doubleValue > high {
                try fail(path, "must be finite and between \(String(format: "%g", low)) and \(String(format: "%g", high))")
            }
        case "boolean":
            guard let number = value as? NSNumber, CFGetTypeID(number) == CFBooleanGetTypeID() else { try fail(path, "must be a boolean") }
        case "array":
            guard let items = value as? [Any], items.count >= ((spec["min_items"] as? NSNumber)?.intValue ?? 0),
                  items.count <= ((spec["max_items"] as? NSNumber)?.intValue ?? Int.max) else {
                try fail(path, spec["error"] as? String ?? "must be a list")
            }
            for (index, item) in items.enumerated() {
                var itemSpec = spec["items"] as! [String: Any]
                if index == 0, spec["first_nonempty"] as? Bool == true { itemSpec["nonempty"] = true }
                do { try field(item, itemSpec, "\(path)[\(index)]") }
                catch {
                    if let error = spec["error"] as? String, spec["min_items"] == nil { try fail(path, error) }
                    throw error
                }
            }
            if let max = spec["max_bytes"] as? NSNumber {
                let size = items.reduce(0) { $0 + ($1 as! String).utf8.count + ((spec["separator_bytes"] as? NSNumber)?.intValue ?? 0) }
                if size > max.intValue { try fail(path, spec["bytes_error"] as! String) }
            }
        case "variant":
            guard let object = value as? [String: Any] else { try fail(path, "must be an object") }
            let tag = spec["tag"] as! String, variants = spec["variants"] as! [String: [String: Any]]
            guard let selected = object[tag] as? String, let variant = variants[selected] else { try fail(path + "." + tag, spec["choices_error"] as? String ?? "must be a supported outcome check") }
            let fields = variant["fields"] as! [String: [String: Any]]
            if variant["reject_unknown"] as? Bool == true, !Set(object.keys).isSubset(of: Set(fields.keys).union([tag])) {
                try fail(path, "contains unsupported parameters")
            }
            try validateObject(object, fields, variant["field_order"] as! [String], variant["required"] as! [String], path)
            try rules(variant["rules"] as! [[String: Any]], object, path)
        case "object":
            guard let object = value as? [String: Any] else { try fail(path, "must be an object") }
            let fields = spec["fields"] as! [String: [String: Any]]
            if spec["reject_unknown"] as? Bool == true, !Set(object.keys).isSubset(of: Set(fields.keys)) {
                try fail(path, "contains unsupported parameters")
            }
            try validateObject(object, fields, spec["field_order"] as! [String], spec["required"] as! [String], path)
            try rules(spec["rules"] as! [[String: Any]], object, path)
        case "reference":
            try field(value, (definition["native_schemas"] as! [String: [String: Any]])[spec["schema"] as! String]!, path)
        default: preconditionFailure("Unsupported generated contract field")
        }
    }
    private static func validateObject(_ value: [String: Any], _ fields: [String: [String: Any]], _ order: [String], _ required: [String], _ path: String) throws {
        for key in order { if let value = value[key] { try field(value, fields[key]!, path + "." + key) } }
        for key in required { if value[key] == nil { try fail(path + "." + key, "is required") } }
    }
    static func validateParameters(_ action: [String: Any], kind: ActionKind) throws {
        let selected = (definition["actions"] as! [String: [String: Any]])[kind.rawValue]!
        try validateObject(action, definition["fields"] as! [String: [String: Any]], definition["field_order"] as! [String], selected["required"] as! [String], "action")
        try rules(definition["common_rules"] as! [[String: Any]], action, "action")
        try rules(selected["rules"] as! [[String: Any]], action, "action")
    }
    static func validate(_ input: [String: Any]) throws -> [String: Any] {
        var action = input
        guard let type = action["type"] as? String, var kind = ActionKind(rawValue: type) else { try fail("action.type", "must be a supported action") }
        for rule in definition["normalizations"] as! [[String: Any]] {
            if kind.rawValue == rule["type"] as! String, truthy(action[rule["when_truthy"] as! String]) {
                kind = ActionKind(rawValue: rule["replace_type"] as! String)!
                action["type"] = kind.rawValue
                for key in rule["remove"] as! [String] { action.removeValue(forKey: key) }
            }
        }
        if action["operation"] != nil {
            guard kind == .run_command else { try fail("action.operation", "is only supported for run_command") }
            action = try compileCommandOperation(action)
        }
        try validateParameters(action, kind: kind)
        return action
    }
    static func validateOutcomeCheck(_ value: Any, path: String = "check") throws -> [String: Any] {
        let fields = definition["fields"] as! [String: [String: Any]]
        try field(value, fields["checks"]!["items"] as! [String: Any], path)
        return value as! [String: Any]
    }
    static func operationDefinition(_ type: String) -> [String: Any]? {
        (definition["command_operations"] as! [String: [String: Any]])[type]
    }
    private static func compileCommandOperation(_ input: [String: Any]) throws -> [String: Any] {
        var action = input
        let fields = definition["fields"] as! [String: [String: Any]]
        try field(action["operation"]!, fields["operation"]!, "action.operation")
        let operation = action["operation"] as! [String: Any]
        let recipe = operationDefinition(operation["type"] as! String)!
        if action["command"] != nil { try fail("action.command", "cannot accompany a command operation") }
        var parameters = operation
        for (name, spec) in recipe["fields"] as! [String: [String: Any]] where spec["format"] as? String == "path" {
            let path = (parameters[name] as! NSString).expandingTildeInPath
            if path.split(separator: "/").contains("..") {
                try fail("action.operation." + name, "must not contain parent traversal; use general shell for complex paths")
            }
            parameters[name] = path
        }
        func resolve(_ value: Any) -> Any {
            if let object = value as? [String: Any] {
                if object.count == 1, let parameter = object["parameter"] as? String { return parameters[parameter]! }
                return object.mapValues(resolve)
            }
            if let array = value as? [Any] { return array.map(resolve) }
            return value
        }
        let argv = resolve(recipe["argv"]!) as! [String]
        var checks = resolve(recipe["checks"]!) as! [[String: Any]]
        if let supplied = action["argv"] {
            try field(supplied, fields["argv"]!, "action.argv")
            if supplied as! [String] != argv { try fail("action.argv", "must match the established operation template") }
        }
        if let supplied = action["checks"] {
            try field(supplied, fields["checks"]!, "action.checks")
            for check in supplied as! [[String: Any]] where !checks.contains(where: { NSDictionary(dictionary: $0).isEqual(to: check) }) {
                checks.append(check)
            }
        }
        action["argv"] = argv; action["checks"] = checks
        return action
    }
    @discardableResult
    static func validateNativePayload(_ schema: String, _ value: Any, path: String? = nil) throws -> [String: Any] {
        let fieldPath = path ?? schema
        do { try field(value, (definition["native_schemas"] as! [String: [String: Any]])[schema]!, fieldPath) }
        catch { throw NativeProtocolError(message: error.localizedDescription) }
        let payload = value as! [String: Any]
        try validateFileFormatPayload(schema, payload, path: fieldPath)
        return payload
    }
    private static func expectedFileFormat(_ path: String?) -> String? {
        guard let path else { return nil }
        switch URL(fileURLWithPath: (path as NSString).expandingTildeInPath).pathExtension.lowercased() {
        case "pdf": return "pdf"
        case "docx": return "docx"
        case "xlsx": return "xlsx"
        default: return nil
        }
    }
    private static func validateFileFormatAttestation(_ schema: String, _ value: [String: Any], path: String,
                                                      required: Bool = false) throws {
        let expected = expectedFileFormat(value["path"] as? String)
        let attestation = value["file_format"] as? [String: Any]
        guard let expected else {
            if value["file_format"] != nil {
                throw NativeProtocolError(message: path + ".file_format is not valid for this destination")
            }
            return
        }
        guard let attestation else {
            if required || (schema == "check_result" && ["file_exists", "file_contents"].contains(value["type"] as? String ?? "") &&
                            value["verified"] as? Bool == true) {
                throw NativeProtocolError(message: path + ".file_format is required for a verified \(expected.uppercased()) result")
            }
            return
        }
        guard attestation["format"] as? String == expected, attestation["verified"] as? Bool == true else {
            throw NativeProtocolError(message: path + ".file_format must verify the requested \(expected.uppercased()) format")
        }
    }
    private static func validateFileFormatPayload(_ schema: String, _ value: [String: Any], path: String) throws {
        switch schema {
        case "action_result":
            if value["action_type"] as? String == "write_file", value["verified"] as? Bool == true {
                try validateFileFormatAttestation(schema, value, path: path, required: true)
            }
            for (index, checked) in (value["checks"] as? [[String: Any]] ?? []).enumerated() {
                try validateFileFormatAttestation("check_result", checked, path: "\(path).checks[\(index)]")
            }
        case "check_result":
            if ["file_exists", "file_contents"].contains(value["type"] as? String ?? "") {
                try validateFileFormatAttestation(schema, value, path: path)
            }
        case "check_batch":
            for (index, checked) in (value["checks"] as? [[String: Any]] ?? []).enumerated() {
                try validateFileFormatAttestation("check_result", checked, path: "\(path).checks[\(index)]")
            }
        case "evidence_fact":
            let kind = value["type"] as? String
            try validateFileFormatAttestation(schema, value, path: path,
                required: ["file_exists", "file_contents", "file_append", "file_written"].contains(kind ?? ""))
        case "evidence":
            if let fact = value["fact"] as? [String: Any] {
                try validateFileFormatPayload("evidence_fact", fact, path: path + ".fact")
            }
        case "receipt":
            if let result = value["result"] as? [String: Any] {
                try validateFileFormatPayload("action_result", result, path: path + ".result")
            }
        default: break
        }
    }
    private static func validateCheckPairs(_ requested: [[String: Any]], _ actual: [[String: Any]], _ path: String) throws {
        guard requested.count == actual.count else { throw NativeProtocolError(message: path + ".checks must match requested_checks") }
        for (index, pair) in zip(requested, actual).enumerated() {
            let (check, checked) = pair
            if check["type"] as? String != checked["type"] as? String ||
                (check["path"] != nil && URL(fileURLWithPath: (check["path"] as! NSString).expandingTildeInPath).standardizedFileURL.path != checked["path"] as? String) {
                throw NativeProtocolError(message: "\(path).checks[\(index)] must match the requested target and check")
            }
            if checked["verified"] as! Bool, ["file_contents", "stdout_equals"].contains(check["type"] as! String) {
                let stdout = check["type"] as! String == "stdout_equals"
                let text = check[stdout ? "text" : "content"] as! String
                let data = (check["encoding"] as? String)?.lowercased() == "base64" ? Data(base64Encoded: text)! : Data(text.utf8)
                let key = stdout ? "text_sha256" : "content_sha256"
                if checked[key] as! String != SHA256.hash(data: data).map({ String(format: "%02x", $0) }).joined() {
                    throw NativeProtocolError(message: "\(path).checks[\(index)].\(key) must match the requested contents")
                }
            }
        }
    }
    @discardableResult
    static func validateCheckBatch(_ value: [String: Any], path: String = "result", requestedChecks: [[String: Any]]? = nil) throws -> [String: Any] {
        try validateNativePayload("check_batch", value, path: path)
        try validateCheckPairs(value["requested_checks"] as! [[String: Any]], value["checks"] as! [[String: Any]], path)
        if let requestedChecks {
            func identity(_ check: [String: Any]) throws -> [String] {
                do { _ = try validateOutcomeCheck(check) } catch { throw NativeProtocolError(message: error.localizedDescription) }
                let target = (check["path"] as? NSString).map { URL(fileURLWithPath: $0.expandingTildeInPath).standardizedFileURL.path } ?? ""
                var data = Data()
                if check["type"] as? String == "file_contents" {
                    let text = check["content"] as! String
                    data = (check["encoding"] as? String)?.lowercased() == "base64" ? Data(base64Encoded: text)! : Data(text.utf8)
                } else if let text = check["text"] as? String { data = Data(text.utf8) }
                return [check["type"] as! String, target, data.base64EncodedString()]
            }
            guard try (value["requested_checks"] as! [[String: Any]]).map(identity) == requestedChecks.map(identity) else {
                throw NativeProtocolError(message: path + ".requested_checks must match the pending readback")
            }
        }
        return value
    }
    @discardableResult
    static func validateNativeReadback(_ value: [String: Any], action input: [String: Any], path: String = "result") throws -> [String: Any] {
        let action: [String: Any]
        do { action = try validate(input) } catch { throw NativeProtocolError(message: error.localizedDescription) }
        if action["type"] as? String == "read_file" { return try validateNativeResult(value, action: action, path: path) }
        let requested: [[String: Any]]
        if action["type"] as? String == "write_file", (action["mode"] as? String ?? "overwrite").lowercased() == "overwrite" {
            requested = [["type": "file_contents"].merging(action.filter { ["path", "content", "encoding"].contains($0.key) }) { _, new in new }]
        } else if action["type"] as? String == "run_command" {
            requested = (action["checks"] as? [[String: Any]] ?? []).filter { $0["type"] as? String != "stdout_equals" }
        } else { throw NativeProtocolError(message: path + " cannot acknowledge an unsupported readback") }
        return try validateCheckBatch(value, path: path, requestedChecks: requested)
    }
    @discardableResult
    static func validateNativeResult(_ value: [String: Any], action: [String: Any]? = nil, path: String = "result") throws -> [String: Any] {
        try validateNativePayload("action_result", value, path: path)
        if let input = action {
            let action: [String: Any]
            do { action = try validate(input) } catch { throw NativeProtocolError(message: error.localizedDescription) }
            guard value["action_type"] as? String == action["type"] as? String else {
                throw NativeProtocolError(message: path + ".action_type must match the requested action")
            }
            if ["read_file", "write_file"].contains(action["type"] as? String ?? ""),
               value["path"] as? String != URL(fileURLWithPath: (action["path"] as! NSString).expandingTildeInPath).standardizedFileURL.path {
                throw NativeProtocolError(message: path + ".path must match the requested target")
            }
            if action["type"] as? String == "read_file", (value["bytes_returned"] as! Int) > (action["max_bytes"] as? Int ?? defaultValue(.read_file, "max_bytes") as! Int) {
                throw NativeProtocolError(message: path + ".bytes_returned must not exceed the requested read limit")
            }
            if action["type"] as? String == "write_file" {
                let content = action["content"] as! String
                let data = (action["encoding"] as? String)?.lowercased() == "base64" ? Data(base64Encoded: content)! : Data(content.utf8)
                guard value["mode"] as? String == (action["mode"] as? String ?? defaultValue(.write_file, "mode") as! String).lowercased(),
                      value["bytes_written"] as? Int == data.count,
                      value["content_sha256"] as? String == SHA256.hash(data: data).map({ String(format: "%02x", $0) }).joined() else {
                    throw NativeProtocolError(message: path + " must verify the requested write")
                }
            }
            if action["type"] as? String == "run_command" {
                let requested = value["outcome_checks"] as? [[String: Any]] ?? action["checks"] as? [[String: Any]] ?? []
                let operation = action["operation"] as? [String: Any], returned = value["command_operation"] as? [String: Any]
                guard (operation == nil && returned == nil) || (operation != nil && returned != nil && NSDictionary(dictionary: operation!).isEqual(to: returned!)) else {
                    throw NativeProtocolError(message: path + ".command_operation must match the requested operation")
                }
                if let operation {
                    let expected = action["checks"] as! [[String: Any]], snapshot = operationDefinition(operation["type"] as! String)!["snapshot"] as? [String: Any]
                    guard NSArray(array: Array(requested.prefix(expected.count))).isEqual(to: expected),
                          snapshot != nil || NSArray(array: requested).isEqual(to: expected) else {
                        throw NativeProtocolError(message: path + ".outcome_checks must include exactly the requested operation checks")
                    }
                    if let snapshot {
                        let extra = Array(requested.dropFirst(expected.count)), candidates = extra.isEmpty ? expected : extra
                        guard extra.count <= 1, candidates.contains(where: { $0["type"] as? String == "file_contents" && $0["encoding"] as? String == "base64" && $0["path"] as? String == operation[snapshot["destination"] as! String] as? String }) else {
                            throw NativeProtocolError(message: path + ".outcome_checks must include the bound source snapshot")
                        }
                    }
                }
                try validateCheckPairs(requested, value["checks"] as! [[String: Any]], path)
            }
        }
        if value["action_type"] as? String == "run_command" {
            let digest = SHA256.hash(data: Data((value["stdout"] as! String).utf8)).map { String(format: "%02x", $0) }.joined()
            for (index, checked) in (value["checks"] as! [[String: Any]]).enumerated() {
                if checked["type"] as? String == "stdout_equals", checked["verified"] as! Bool,
                   value["stdout_truncated"] as! Bool || checked["text_sha256"] as? String != digest {
                    throw NativeProtocolError(message: "\(path).checks[\(index)] must verify the returned stdout without truncation")
                }
            }
        }
        if value["action_type"] as? String == "read_file" {
            let text = value["content"] as! String
            guard let data = value["encoding"] as? String == "base64" ? Data(base64Encoded: text) : Data(text.utf8),
                  data.count == value["bytes_returned"] as? Int,
                  SHA256.hash(data: data).map({ String(format: "%02x", $0) }).joined() == value["content_sha256"] as? String else {
                throw NativeProtocolError(message: path + ".content must match returned length and digest")
            }
        }
        return value
    }
    @discardableResult
    static func validateNativeReceipt(_ value: [String: Any], actionID: String? = nil, action: [String: Any]? = nil, path: String = "receipt") throws -> [String: Any] {
        try validateNativePayload("receipt", value, path: path)
        if let actionID, (value["action_id"] as! String).lowercased() != actionID.lowercased() {
            throw NativeProtocolError(message: path + ".action_id must match the pending action")
        }
        let expected = (definition["receipt_outcomes"] as! [String: String])[value["state"] as! String]
        if let result = value["result"] as? [String: Any] {
            try validateNativeResult(result, action: action, path: path + ".result")
            guard expected == result["outcome"] as? String else { throw NativeProtocolError(message: path + ".state must agree with result.outcome") }
            guard nativeErrorFields.filter({ $0 != "terminal" }).allSatisfy({ value[$0] == nil }) else {
                throw NativeProtocolError(message: path + " cannot contain both result and error fields")
            }
        } else if value["error"] != nil {
            try validateNativePayload("error", value.filter { nativeErrorFields.contains($0.key) }, path: path + ".error_payload")
            guard expected == value["outcome"] as? String else { throw NativeProtocolError(message: path + ".state must agree with error.outcome") }
        }
        return value
    }
    static var nativeErrorFields: Set<String> {
        let schemas = definition["native_schemas"] as! [String: [String: Any]]
        return Set((schemas["error"]!["fields"] as! [String: Any]).keys)
    }
    static func nativeFailure(_ error: Error, code: String, outcome: String) -> [String: Any] {
        ["error": error.localizedDescription, "error_code": code, "outcome": outcome,
         "verified": false, "verification_scope": "none", "terminal": outcome != "dispatched"]
    }
    @discardableResult
    static func validateNativeEvidence(_ value: [String: Any], path: String = "evidence") throws -> [String: Any] {
        try validateNativePayload("evidence", value, path: path)
        guard value["verification_scope"] as? String == (value["fact"] as! [String: Any])["type"] as? String else {
            throw NativeProtocolError(message: path + ".verification_scope must name the verified fact")
        }
        if let action = value["action"] as? [String: Any] {
            do { _ = try validate(action) } catch { throw NativeProtocolError(message: error.localizedDescription) }
        }
        return value
    }
